# TELEGRAM BOT
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=980561369,1280669796
# MONGODB
MONGO_URI=mongodb://localhost:27017/sensei
MONGO_DB=sensei

# CRYPTO API
TON_API_KEY=

# APP SETTINGS
DEBUG=false
MAINTENANCE_MODE=false

# BANK
BANK_INITIAL_COINS=1000000000

# GEMINI
GEMINI_API_KEY=your_gemini_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
# WIDGET INTERFACE (Bot API image fallback, not native messageMediaWidget)
WIDGETS_ENABLED=true

# Animated GIF cards; false keeps static PNG (no extra API keys or ffmpeg needed)
WIDGET_ANIMATIONS_ENABLED=true

# Daily hedgehog Mini App: HTTPS base URL (or Render RENDER_EXTERNAL_URL auto-detection)
MINI_APP_URL=

# Native chat widgets: default uses the normal Bot API endpoint.
# ONLY for Telegram's separate widget beta/test bot and test chats:
# TELEGRAM_WIDGET_BETA=true

# Optional direct native HTMLBubbles delivery via production MTProto layer 233.
# Default remains bot_api. MTProto requires YOUR app credentials in server secrets.
NATIVE_WIDGET_TRANSPORT=bot_api
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# For mtproto: keep TELEGRAM_WIDGET_BETA=false, use the SAME existing BOT_TOKEN.
