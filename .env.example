# TELEGRAM BOT
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=980561369,1280669796
# MONGODB
MONGO_URI=mongodb://localhost:27017/sensei
MONGO_DB=sensei

# CRYPTO API
TON_API_KEY=

# APP SETTINGS
DEBUG=false
MAINTENANCE_MODE=false

# BANK
BANK_INITIAL_COINS=1000000000

# GEMINI
GEMINI_API_KEY=your_gemini_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
# WIDGET INTERFACE (Bot API image fallback, not native messageMediaWidget)
WIDGETS_ENABLED=true

# Animated GIF cards; false keeps static PNG (no extra API keys or ffmpeg needed)
WIDGET_ANIMATIONS_ENABLED=true

# Daily hedgehog Mini App: HTTPS base URL (or Render RENDER_EXTERNAL_URL auto-detection)
MINI_APP_URL=

# Native chat widgets: default uses the normal Bot API endpoint.
# ONLY for Telegram's separate widget beta/test bot and test chats:
# TELEGRAM_WIDGET_BETA=true

# Optional direct native HTMLBubbles delivery via production MTProto layer 233.
# Default remains bot_api. MTProto requires YOUR app credentials in server secrets.
NATIVE_WIDGET_TRANSPORT=bot_api
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# For mtproto: keep TELEGRAM_WIDGET_BETA=false, use the SAME existing BOT_TOKEN.

# CHANNEL COMMENT COIN CAMPAIGNS (opt-in)
COMMENT_CAMPAIGNS_ENABLED=false
# Numeric IDs are recommended. With 0, resolve @SenseiDurova and its linked
# discussion once at startup, validate rights and pin numeric IDs in MongoDB.
TARGET_CHANNEL_ID=0
DISCUSSION_CHAT_ID=0
CAMPAIGN_DURATION_HOURS=4
BASE_REWARD=100
WINNER_REWARD=2000
REWARD_PER_UNIQUE_USER=false
WINNER_REWARD_MODE=total
# Existing MONGO_URI/MONGO_DB must point to a replica set/mongos.
# MongoDB is the durable scheduled-job queue; no Redis/Celery required.
CAMPAIGN_POLL_SECONDS=5
CAMPAIGN_LEASE_SECONDS=180
CAMPAIGN_RETRY_SECONDS=60
CAMPAIGN_SETTLEMENT_GRACE_SECONDS=30
CAMPAIGN_BATCH_SIZE=25
# MUST be placed on a persistent volume in production, e.g. Render /var/data.
CAMPAIGN_INBOX_PATH=var/comment_campaign_inbox.sqlite3
CAMPAIGN_ALLOWED_CONTENT_TYPES=text,photo,video,animation,audio,voice,video_note,document,sticker,poll,contact,location,venue,dice
